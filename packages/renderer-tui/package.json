  "description": "Cyberpsychosis TUI — Zero-binding ASCII/ANSI terminal renderer and causal lineage inspector",
  "author": "PlutoKeating <PlutoKeating@outlook.com>",
  "homepage": "https://cyberpsychosis.plutokeating.beer",
  "repository": {
    "type": "git",
