# Cyberpsychosis Engine Environment Configuration Template
# Copy this file to .env if you want to enable live LLM API calls for the Semantic Bridge plugin.
# Without an API key, the Semantic Bridge automatically uses the deterministic offline rule compiler.

CYBERPSYCHOSIS_LLM_PROVIDER=mock
CYBERPSYCHOSIS_LLM_API_KEY=
CYBERPSYCHOSIS_LLM_BASE_URL=https://api.openai.com/v1
CYBERPSYCHOSIS_LLM_MODEL=gpt-4o-mini

# Web Workbench Server Port
CYBERPSYCHOSIS_WEB_PORT=4173
